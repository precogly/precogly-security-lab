#!/bin/bash
# Scanner box first boot: Docker, lab's prerequisites, and the tailnet with
# Tailscale SSH on. Rendered by templatefile() in scanner.tf.
#
# templatefile() interpolates every dollar-brace, comments included, so the
# script below never uses that form.
set -euo pipefail

# shellcheck disable=SC2154 # assigned by templatefile(), not by the shell
REGION="${region}"
# shellcheck disable=SC2154
AUTHKEY_SECRET="${authkey_secret_arn}"
# shellcheck disable=SC2154
TS_HOSTNAME="${tailscale_hostname}"
# shellcheck disable=SC2154
TS_TAG="${tailscale_tag}"
# shellcheck disable=SC2154
FQDN="${tailscale_hostname}.${tailnet_domain}"
# shellcheck disable=SC2154
UV_VERSION="${uv_version}"

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io jq
usermod -aG docker ubuntu

# lab's prerequisites: uv to install it, and the directory runs land in. lab
# itself is installed at a commit by hand (docs/setup.md), so moving it never
# replaces the box.
sudo -u ubuntu -H sh -c "curl -LsSf https://astral.sh/uv/$UV_VERSION/install.sh | sh -s -- --quiet"
install -d -o ubuntu -g ubuntu /var/lib/lab

# The AWS CLI, to read the auth key. The Ubuntu AMI does not ship it; the snap
# is the distribution AWS documents for Ubuntu.
snap install aws-cli --classic

# Waits for an auth key to be put in by hand, skipping the placeholder the last
# box left; see precogly-user-data.sh.tftpl for why both halves are needed.
read_authkey() {
  local secret_id="$1" deadline=$((SECONDS + 3600)) value
  while true; do
    value="$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$secret_id" \
      --query SecretString --output text 2>/dev/null || true)"
    if [[ "$value" == tskey-auth-* ]]; then
      printf '%s\n' "$value"
      return 0
    fi
    if ((SECONDS >= deadline)); then
      echo "gave up waiting for a tskey-auth- value in $secret_id" >&2
      return 1
    fi
    echo "waiting for a tskey-auth- value in $secret_id" >&2
    sleep 30
  done
}

# shellcheck source=/dev/null
. /etc/os-release
curl -fsSLo /usr/share/keyrings/tailscale-archive-keyring.gpg \
  "https://pkgs.tailscale.com/stable/ubuntu/$VERSION_CODENAME.noarmor.gpg"
curl -fsSLo /etc/apt/sources.list.d/tailscale.list \
  "https://pkgs.tailscale.com/stable/ubuntu/$VERSION_CODENAME.tailscale-keyring.list"
apt-get update
apt-get install -y tailscale
systemctl enable --now tailscaled

# Two differences from the instance:
#
# --ssh turns on Tailscale SSH, so people get a shell here by tailnet identity,
# with no key and no IAM user. The policy's `ssh` rule decides who, and as
# which local user (docs/setup.md).
#
# DNS is accepted (the default), because scanners have to resolve the
# instance's ts.net name, which only MagicDNS answers.
install -m 600 /dev/null /run/tailscale-authkey
read_authkey "$AUTHKEY_SECRET" > /run/tailscale-authkey
tailscale up \
  --auth-key=file:/run/tailscale-authkey \
  --advertise-tags="$TS_TAG" \
  --hostname="$TS_HOSTNAME" \
  --ssh
rm -f /run/tailscale-authkey

# The key is spent; overwrite it so the next box waits for a fresh one.
aws secretsmanager put-secret-value --region "$REGION" --secret-id "$AUTHKEY_SECRET" \
  --secret-string spent >/dev/null

ACTUAL_FQDN="$(tailscale status --json | jq -r '.Self.DNSName | rtrimstr(".")')"
if [[ "$ACTUAL_FQDN" != "$FQDN" ]]; then
  echo "joined as $ACTUAL_FQDN, expected $FQDN: remove the old node from the Machines page and replace this instance" >&2
  exit 1
fi
echo "scanner box is up at $FQDN; ssh ubuntu@$TS_HOSTNAME"
